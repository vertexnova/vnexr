                <mxCell id="legend" value="Pink = the ordering constraint both bindings share.&#10;Today's OpenXrVulkanGraphics violates it: it creates a default&#10;device first, then queries requirements and discards the result." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2185b;strokeWidth=2;fontSize=10;align=left;spacingLeft=8;fontColor=#1a1a1a;" parent="1" vertex="1">
