                    <mxGeometry x="810" y="570" width="330" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="gap" value="CI gap worth closing first&#10;&#10;The Linux OpenXR job passes -DVNE_XR_EXAMPLES=ON, but VNE_XR_CI=ON force-sets VNE_XR_SAMPLES=OFF.&#10;Result: 02_openxr_stereo &#8212; the only sample that exercises this backend &#8212; is never compiled by CI.&#10;Until that is fixed, every row above rests on code no automated check has built." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2185b;strokeWidth=3;fontSize=11;align=left;spacingLeft=12;fontColor=#1a1a1a;" parent="1" vertex="1">
