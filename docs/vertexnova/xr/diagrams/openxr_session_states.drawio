                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="gapbox" value="GAP &#8212; app-requested exit is not wired to the runtime&#10;&#10;LayerParams::request_exit is honoured by NullSession and VisionOsSession,&#10;but OpenXrSession::endFrame() ignores it. ISession::run() breaks its loop, so the&#10;session is destroyed mid-flight instead of walking STOPPING &#8594; IDLE &#8594; EXITING.&#10;&#10;Intent: endFrame() should call xrRequestExitSession() and let the runtime&#10;drive the transitions above." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;strokeWidth=3;fontSize=11;align=left;spacingLeft=10;fontColor=#1a1a1a;" parent="1" vertex="1">
                    <mxGeometry x="70" y="700" width="620" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="effects" value="Side effects on entry&#10;&#10;READY&#9;&#9;xrBeginSession(), session_begun_ = true, session_running_ = true&#10;SYNCHRONIZED&#9;session_running_ = true&#10;VISIBLE / FOCUSED&#9;session_running_ = true&#10;STOPPING&#9;&#9;xrEndSession(), swapchain_bridge_.destroy()&#10;LOSS_PENDING&#9;session_running_ = false&#10;EXITING&#9;&#9;session_running_ = false, running_ = false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#616161;strokeWidth=2;fontSize=11;align=left;spacingLeft=10;fontColor=#1a1a1a;" parent="1" vertex="1">
                    <mxGeometry x="720" y="700" width="460" height="165" as="geometry"/>
                </mxCell>
