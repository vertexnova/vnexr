                </mxCell>
                <mxCell id="t10lbl" value="from any state&#10;(runtime lost)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#c2185b;backgroundColor=#ffffff;" parent="t10" connectable="0" vertex="1">
