                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="reqexitlbl" value="xrRequestExitSession()&#10;(intended)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#c2185b;backgroundColor=#ffffff;" parent="reqexit" connectable="0" vertex="1">
                    <mxGeometry x="-0.1" y="1" relative="1" as="geometry">
