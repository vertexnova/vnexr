plugins {
    id 'com.android.application'
}

android {
    namespace 'com.vertexnova.vnexr.samples'
    compileSdk 34

@VNE_ANDROID_NDK_VERSION_LINE@

    defaultConfig {
        minSdk 24
        targetSdk 34
        versionCode 1
        versionName '1.0.0'
        ndk {
            abiFilters 'arm64-v8a', 'x86_64'
        }
        externalNativeBuild {
            cmake {
                arguments '-DANDROID_STL=c++_shared',
                          '-DANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES=ON'
                cppFlags '-std=c++20'
            }
        }
    }

    flavorDimensions 'sample'
    productFlavors {
@VNE_ANDROID_PRODUCT_FLAVORS@
    }

    buildTypes {
        release {
            minifyEnabled false
        }
        debug {
            debuggable true
        }
    }

    externalNativeBuild {
        cmake {
            path '../native/CMakeLists.txt'
@VNE_ANDROID_CMAKE_VERSION_LINE@
        }
    }

    packaging {
        jniLibs {
            useLegacyPackaging = true
        }
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }
}

dependencies {
}
