<?xml version="1.0" encoding="utf-8"?>
<!-- OpenXR immersive NativeActivity for Galaxy XR (Android XR) and Meta Quest 3 (Horizon OS). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="true"
        android:version="1" />
    <uses-feature
        android:name="android.software.xr.api.openxr"
        android:required="true"
        android:version="0x00010000" />
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:required="true"
        android:version="0" />
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x400003"
        android:required="true" />
    <!-- Quest: hands are optional; controllers still drive the samples without them. -->
    <uses-feature
        android:name="oculus.software.handtracking"
        android:required="false" />

    <!-- The Khronos loader is built from source, not taken from the AAR, so its broker permissions are listed here. -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <!-- Quest: XR_EXT_hand_interaction reports no hand data without this. -->
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />

    <!-- Discover installed OpenXR runtimes (Android XR broker / vendor runtimes). -->
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:hasCode="true"
        android:label="${vneAppLabel}">

        <activity
            android:name="com.vertexnova.vnexr.samples.VneXrNativeActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <meta-data
                android:name="android.app.lib_name"
                android:value="${vneNativeLib}" />
            <!-- Android XR / OpenXR immersive start mode (full space). -->
            <meta-data
                android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
                android:value="XR_ACTIVITY_START_MODE_FULL_SPACE_UNMANAGED" />
            <!-- Quest: keep running under the system menu overlay instead of pausing. -->
            <meta-data
                android:name="com.oculus.vr.focusaware"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Quest: without this category Horizon OS starts the app as a 2D panel, not immersive. -->
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
    </application>
</manifest>
