cmake_minimum_required(VERSION 3.26)

set(ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES ON)

project(vne_xr_android_samples LANGUAGES CXX C)

if(NOT DEFINED VNE_XR_ANDROID_SAMPLE OR VNE_XR_ANDROID_SAMPLE STREQUAL "")
    message(FATAL_ERROR "VNE_XR_ANDROID_SAMPLE must be set by Gradle for the active product flavor")
endif()

set(VNE_XR_ANDROID_SAMPLE "${VNE_XR_ANDROID_SAMPLE}" CACHE STRING "Active Android Gradle sample target" FORCE)
if(DEFINED VNE_XR_ANDROID_PACKAGE AND NOT VNE_XR_ANDROID_PACKAGE STREQUAL "")
    set(VNE_XR_ANDROID_PACKAGE "${VNE_XR_ANDROID_PACKAGE}" CACHE STRING "Active Android Gradle package id" FORCE)
endif()

set(VNEXR_ROOT "@VNEXR_ROOT@")

set(VNE_XR_SAMPLES ON CACHE BOOL "" FORCE)
set(VNE_XR_TESTS OFF CACHE BOOL "" FORCE)
set(VNE_XR_DEV ON CACHE BOOL "" FORCE)
set(VNE_XR_LIB_TYPE "static" CACHE STRING "" FORCE)
set(VNE_TARGET_PLATFORM "Android" CACHE STRING "" FORCE)
set(VNE_XR_WITH_OPENXR ON CACHE BOOL "" FORCE)
set(VNE_XR_WITH_RHI ON CACHE BOOL "" FORCE)
set(VNE_XR_BACKEND_VULKAN ON CACHE BOOL "" FORCE)

add_subdirectory("${VNEXR_ROOT}" "${CMAKE_BINARY_DIR}/vnexr")

if(NOT TARGET "${VNE_XR_ANDROID_SAMPLE}")
    message(FATAL_ERROR "Android sample target '${VNE_XR_ANDROID_SAMPLE}' was not created")
endif()
